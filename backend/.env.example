# Supabase
SUPABASE_URL=https://your-project.supabase.co
# This MUST be the SECRET key (starts with sb_secret_, or a legacy
# service_role JWT) — NOT the publishable/anon key. Every table in
# database/schema.sql has Row-Level Security enabled with zero policies,
# so only the secret key can read/write them; the publishable key will
# fail every request with a silent 500 (RLS violation, error code 42501).
SUPABASE_SERVICE_KEY=your-secret-key
# Required by app/config.py but not actually used for verification — the
# auth middleware verifies tokens via Supabase's JWKS endpoint (ES256), not
# this shared secret. Any non-empty placeholder works.
SUPABASE_JWT_SECRET=unused-not-checked-by-backend

# Groq (used for Whisper STT + Drill Generator LLM)
GROQ_API_KEY=your-groq-api-key

# Google Gemini (used for Speech Analyser)
GEMINI_API_KEY=your-gemini-api-key

# Model configuration (defaults shown, override if needed)
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash

# EMA scoring
# EMA_ALPHA=0.4
