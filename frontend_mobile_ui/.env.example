# Copy this file to .env and fill in real values before running the app.
# Expo only inlines variables prefixed with EXPO_PUBLIC_ into the client bundle —
# never put a secret (service-role key, private API key, etc.) behind that prefix,
# because it ships inside the app binary and is readable by anyone who installs it.
# The Supabase "anon" key below is designed to be public; row-level security on
# the Supabase project is what actually protects data, not keeping this key secret.

# Base URL of the FastAPI backend. Must be HTTPS in any non-local environment.
# "localhost" means different things depending on where the app runs:
#   - iOS Simulator:        http://localhost:8000
#   - Android Emulator:     http://10.0.2.2:8000
#   - Physical device (Expo Go): http://<your-machine-LAN-IP>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project (safe/public anon key, not the service-role key). Must be
# the same project backend/.env points at (SUPABASE_URL / SUPABASE_SERVICE_KEY).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
